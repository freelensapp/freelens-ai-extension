{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["*.ts", "src/**/*"],
  "compilerOptions": {
    "composite": true,
    "esModuleInterop": true,
    "moduleResolution": "node10",
    "jsx": "react-jsx",
    "types": ["vite/client", "electron-vite/node"],
    "paths": {
      "@vitejs/plugin-react": ["./node_modules/@vitejs/plugin-react/dist/index.d.ts"],
      "@strands-agents/sdk/models/openai": ["./node_modules/@strands-agents/sdk/dist/src/models/openai/index.d.ts"],
      "@modelcontextprotocol/sdk/client/stdio.js": [
        "./node_modules/@modelcontextprotocol/sdk/dist/cjs/client/stdio.d.ts"
      ],
      "@modelcontextprotocol/sdk/client/sse.js": ["./node_modules/@modelcontextprotocol/sdk/dist/cjs/client/sse.d.ts"]
    }
  }
}
